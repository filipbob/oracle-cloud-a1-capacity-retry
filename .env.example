# OCI account and authentication profile
TENANCY_NAME=your-tenancy-name
COMPARTMENT_ID=replace-with-your-compartment-ocid
REGION=your-home-region
OCI_CONFIG_FILE=/absolute/path/to/oci/config
OCI_PROFILE=DEFAULT
OCI_BIN=

# Target compute request
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12
TOTAL_OCPU_LIMIT=2
TOTAL_MEMORY_LIMIT=12
DISPLAY_NAME=a1-capacity-retry
SSH_KEY_FILE=/absolute/path/to/ssh-public-key.pub

# Existing network/image; leave IDs empty to resolve them dynamically
SUBNET_ID=
IMAGE_ID=
IMAGE_OS="Oracle Linux"
IMAGE_OS_VERSION=9
ASSIGN_PUBLIC_IP=true

# Availability domains, comma-separated. Use the exact names from your tenancy.
ADS=AD-1,AD-2,AD-3

# Retry and OCI API behavior
SLEEP_SECONDS=30
MAX_RETRY_DELAY_SECONDS=180
# Optional extra wait per retry cycle, sampled from 0..RETRY_JITTER_SECONDS.
# 0 preserves fixed delays; for example, 30 adds up to 30 seconds.
RETRY_JITTER_SECONDS=0
CAPACITY_REQUEST_DELAY_SECONDS=10
OCI_READ_TIMEOUT=30
OCI_NO_RETRY=1
LAUNCH_WAIT_STATE=RUNNING
LAUNCH_MAX_WAIT_SECONDS=120
NETWORK_RECHECK_DELAYS=5,10,20
DRY_RUN=0
LOCK_FILE=/tmp/oci_capacity_retry.lock

# Logging: one file per calendar day; files older than LOG_RETENTION_DAYS are removed
LOG_TO_FILE=1
LOG_DIR=
LOG_PREFIX=oci-capacity-retry
LOG_RETENTION_DAYS=3

# Clock safety: OCI signs requests with the local system clock. The script
# checks the clock against these public NTP servers before OCI calls. Configure
# macOS automatic time separately; this check does not change the system clock.
NTP_CHECK_ENABLED=1
NTP_SERVERS=time.apple.com,pool.ntp.org,time.nist.gov
NTP_MAX_OFFSET_SECONDS=120
NTP_TIMEOUT_SECONDS=5
NTP_RETRY_DELAY_SECONDS=30
SNTP_BIN=

# Optional Bark notifications. An empty key disables push notifications.
# Keep the real device key in your private .env, never in this template.
BARK_KEY=
BARK_SERVER_URL=https://api.day.app
# Total time budget for the notification worker, including connection and response.
BARK_TIMEOUT_SECONDS=5
BARK_SOUND=
BARK_GROUP=

# Network bootstrap settings
VCN_NAME=a1-vcn
SUBNET_NAME=a1-public
GATEWAY_NAME=a1-igw
SECURITY_LIST_NAME=a1-ssh
SSH_SOURCE_CIDR=0.0.0.0/0
VCN_CIDR_BLOCK=10.0.0.0/16
SUBNET_CIDR_BLOCK=10.0.1.0/24
VCN_DNS_LABEL=a1vcn
SUBNET_DNS_LABEL=a1sub
